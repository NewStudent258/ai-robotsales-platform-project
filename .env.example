APP_NAME=AI Robot Sales Platform
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=mysql+asyncmy://robot_sales:robot_sales@127.0.0.1:3306/robot_sales
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=mock
LLM_MODEL=
REDIS_URL=redis://127.0.0.1:6379/0

# 运营后台写权限令牌（X-Admin-Token）。留空表示关闭后台写能力（默认拒绝）。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# 是否在报价读取响应中回显访问令牌。仅本地调试使用，生产必须保持 false。
EXPOSE_QUOTE_TOKEN=false
